# ========================================================
# RayTech Institute — Environment Configuration
# ========================================================

# 1. OPTIONAL: YouTube Data API v3 Key (Method 1)
# Leave blank to use the authentic local archive (15 lectures).
# Once you add your key below, the website will automatically
# fetch newly uploaded videos from @RaytechInstitute and keep
# the archive in sync.
NEXT_PUBLIC_YOUTUBE_API_KEY=

# Optional public Firebase Web Push VAPID key. Leave blank to hide the
# notification prompt until browser push is fully configured.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# 2. OPTIONAL: Production Email Delivery for Contact Form
# (e.g. Resend API key or SMTP)
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=contact@raytechinstitute.edu

# 3. Supabase Edge Function admin security (configure in Supabase Secrets Vault)
# These are server-side secrets; do not expose them as NEXT_PUBLIC_ variables.
FIREBASE_WEB_API_KEY=
ADMIN_EMAILS=admin@example.com
ALLOWED_ORIGINS=https://raytechinstitute.web.app,https://raytechinstitute.firebaseapp.com
# Change to https://raytechinstitute.com only after Firebase custom-domain HTTPS is verified.
NEXT_PUBLIC_SITE_URL=https://raytechinstitute.web.app
# Optional public HTML ownership token from Search Console, after the domain is ready.
GOOGLE_SITE_VERIFICATION=

# 4. Private learning export: GitHub Actions secret, never NEXT_PUBLIC.
# Locally, the build can read this credential from the already authenticated
# Supabase CLI for the scoped RayTech project without writing a secret file.
SUPABASE_SERVICE_ROLE_KEY=

# 5. Supabase-only student reviewer secret. The existing vault name
# Assignment-ai-api is also accepted when its value is an OpenRouter key.
OPENROUTER_API_KEY=
YOUTUBE_API_KEY=
# Existing Supabase vault alias YOUTUBE-API is also supported server-side.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=mahaddevelpoer/RayTechInstitute

# Codi robot reader. Set false to disable it in a particular build.
# No provider credentials belong here.
NEXT_PUBLIC_CODI_ENABLED=true
# Supabase Edge secret only, never NEXT_PUBLIC. No API key in the static site.
CODI_CLOUD_ENABLED=false
